{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/.*",
      "has": [
        {
          "type": "query",
          "key": "u"
        }
      ],
      "status": 410
    },
    {
      "src": "/.*",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "status": 410
    },
    {
      "src": "^/(?:de|tr|sv|zh|pl|pt|fr|fi|es|no|nl)(?:/.*)?$",
      "status": 410
    },
    {
      "src": "^/(?:index\\.php|index\\.jsp)$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/about-us/?$",
      "status": 301,
      "headers": {
        "Location": "/about/"
      }
    },
    {
      "src": "^/services/?$",
      "status": 301,
      "headers": {
        "Location": "/our-services/"
      }
    },
    {
      "src": "^/contact/?$",
      "status": 301,
      "headers": {
        "Location": "/contact-us/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
